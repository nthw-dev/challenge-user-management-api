{
    "swagger": "2.0",
    "info": {
        "description": "### Authorization\n`/api/v1/users/*` requires a token; `/api/v1/auth/*`, `/healthz`, `/readyz` and `/metrics` do not (see the padlock icon at the end of each row)\n\n1. `POST /api/v1/auth/register` (if no user exists yet) → `POST /api/v1/auth/login` → copy `data.access_token`\n2. Click **Authorize** at the top right and enter `Bearer \u003caccess_token\u003e` — **you must type the `Bearer ` prefix yourself**. The spec is OpenAPI 2.0 and declares `Authorization` as an apiKey, so the page sends the value verbatim and adds nothing\n3. Once it expires per `JWT_ACCESS_TTL`, call `POST /api/v1/auth/refresh` (the old token stops working; reusing it wipes every session) and Authorize again\n\nThe same contract can be called over gRPC at /grpcui/ — there you attach `authorization` as metadata instead of as a header",
        "title": "User Management API",
        "contact": {},
        "license": {
            "name": "MIT"
        },
        "version": "1.0"
    },
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "description": "An email not in the system, a wrong password, and a malformed email all answer identically: 401 INVALID_CREDENTIALS",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Log in",
                "parameters": [
                    {
                        "description": "Email and password",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/respond.DataEnvelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/httpapi.sessionResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "MALFORMED_JSON",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "401": {
                        "description": "INVALID_CREDENTIALS",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "description": "Every rotation invalidates the old token — presenting an already-rotated token wipes every session belonging to that user",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Rotate a refresh token",
                "parameters": [
                    {
                        "description": "The most recent refresh token",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.refreshRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/respond.DataEnvelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/httpapi.sessionResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "MALFORMED_JSON",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "description": "Creates a new user from a name, an email and a password, then returns the user — no token is returned; get one from /auth/login",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Sign up",
                "parameters": [
                    {
                        "description": "The signup details",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.createUserRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/respond.DataEnvelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/httpapi.userResponse"
                                        }
                                    }
                                }
                            ]
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "/api/v1/users/{id}"
                            }
                        }
                    },
                    "400": {
                        "description": "MALFORMED_JSON",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "409": {
                        "description": "EMAIL_TAKEN",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "413": {
                        "description": "PAYLOAD_TOO_LARGE",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "422": {
                        "description": "VALIDATION_ERROR",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/api/v1/users": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Paged by cursor rather than offset, so the data volume does not slow the query down, and no row is duplicated or missed when a write lands in between",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "List users",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Items per page",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "The next_cursor value from the previous page",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search by name or email",
                        "name": "query",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/respond.DataEnvelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/httpapi.userResponse"
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/definitions/httpapi.listMeta"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "422": {
                        "description": "VALIDATION_ERROR",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "A duplicate email is caught by MongoDB's unique index rather than by a pre-check, so there is no TOCTOU window",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Create a user",
                "parameters": [
                    {
                        "description": "The new user's details",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.createUserRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/respond.DataEnvelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/httpapi.userResponse"
                                        }
                                    }
                                }
                            ]
                        },
                        "headers": {
                            "Location": {
                                "type": "string",
                                "description": "/api/v1/users/{id}"
                            }
                        }
                    },
                    "400": {
                        "description": "MALFORMED_JSON",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "409": {
                        "description": "EMAIL_TAKEN",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "413": {
                        "description": "PAYLOAD_TOO_LARGE",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "422": {
                        "description": "VALIDATION_ERROR",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/api/v1/users/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Read a single user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The user's id (24 hex characters)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/respond.DataEnvelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/httpapi.userResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "404": {
                        "description": "USER_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Removes the account and revokes every refresh token it holds. A caller may only delete their own account — any other id answers 403 FORBIDDEN",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Delete a user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The user's id (24 hex characters)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Deleted; no response body"
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "404": {
                        "description": "USER_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Every field in the body is optional; send only the ones you want to change. A caller may only change their own account — any other id answers 403 FORBIDDEN, whether or not it exists",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Update a user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The user's id (24 hex characters)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "The fields to change",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/httpapi.updateUserRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/respond.DataEnvelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/httpapi.userResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "MALFORMED_JSON",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "403": {
                        "description": "FORBIDDEN",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "404": {
                        "description": "USER_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "409": {
                        "description": "EMAIL_TAKEN",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "413": {
                        "description": "PAYLOAD_TOO_LARGE",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    },
                    "422": {
                        "description": "VALIDATION_ERROR",
                        "schema": {
                            "$ref": "#/definitions/respond.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Answers 200 for as long as the process can serve requests; does not touch MongoDB",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "liveness probe",
                "responses": {
                    "200": {
                        "description": "{\\\"status\\\":\\\"ok\\\"}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Answers 503 {\"status\":\"draining\"} once shutdown has begun, so the load balancer stops sending work before the listener closes; otherwise pings MongoDB with a 2-second timeout and answers 503 {\"status\":\"unavailable\"} when it cannot be reached",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "readiness probe",
                "responses": {
                    "200": {
                        "description": "{\\\"status\\\":\\\"ok\\\"}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "{\\\"status\\\":\\\"unavailable\\\"} or {\\\"status\\\":\\\"draining\\\"}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
