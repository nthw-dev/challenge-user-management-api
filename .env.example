# Copy this file to .env and adjust the values — used when running with `make run` on your own machine.
# When running with docker compose, every value comes from docker-compose.yml instead.

APP_ENV=development
HTTP_ADDR=:8080
GRPC_ADDR=:9090
LOG_LEVEL=info

SHUTDOWN_TIMEOUT=15s
# How long /readyz answers 503 "draining" before the listeners close — the load balancer's notice period. 0 is fine on a laptop.
SHUTDOWN_DELAY=2s

# The HTTP server's timeouts — they stop us hanging on a request that is sent slowly or never finished.
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=5s
# Allows for the bcrypt that costs hundreds of milliseconds at login.
SERVER_WRITE_TIMEOUT=10s
# 0 means falling back to SERVER_READ_TIMEOUT, per net/http's semantics.
SERVER_IDLE_TIMEOUT=0
# The ceiling on every gRPC call: a shorter deadline from the caller is honored, a longer one is capped.
SERVER_RPC_TIMEOUT=10s

# Required — without it the app refuses to boot.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=userdb
MONGO_COLLECTION=users
MONGO_REFRESH_COLLECTION=refresh_tokens

# The driver's connection pool — MAX_IDLE_CONNS is the warm reserve held open, and must not exceed MAX_OPEN_CONNS.
MONGO_CONN_TIMEOUT=1m
# 0 means idle connections are never closed.
MONGO_MAX_CONN_IDLE_TIME=30m
MONGO_MAX_IDLE_CONNS=10
MONGO_MAX_OPEN_CONNS=10

# Required — must be at least 32 bytes long.
# Generate a real value with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
JWT_ISSUER=user-service
JWT_AUDIENCE=user-service-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Can be dropped to 4 in tests to keep them fast; production should be at 12.
BCRYPT_COST=12

# The interval of the goroutine that counts users — the brief specifies 10 seconds.
USER_COUNT_INTERVAL=10s

